{
  "name": "@agroprecios/web",
  "version": "0.1.0",
  "description": "PWA de AgroPrecios (Angular)",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/copiar-vendor.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/copiar-vendor.mjs",
    "build": "ng build && node scripts/verificar-peso.mjs",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/copiar-vendor.mjs",
    "test": "ng test --watch=false",
    "lint": "eslint ."
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "chart.js": "^4.6.1",
    "maplibre-gl": "^6.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@agroprecios/shared": "*",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "angular-eslint": "^22.7.0",
    "jsdom": "^30.0.0",
    "vitest": "^5.1.0"
  }
}
