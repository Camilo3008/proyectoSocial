# Plantilla para producción (docker-compose.prod.yml). Copiar a .env.prod y
# reemplazar TODOS los valores. Nunca subir .env.prod al repositorio.
# Los valores de abajo son SOLO de ejemplo.

# --- Dominio y HTTPS (Caddy) ---
# Dominio público que apunta (registro DNS A) a la IP del servidor.
# Sirve un subdominio gratuito, p. ej. agroprecios.duckdns.org (ver docs/DESPLIEGUE-GCP.md).
DOMINIO=agroprecios.example.org
# Correo para avisos de Let's Encrypt (vencimientos de certificado).
ACME_EMAIL=soporte@example.org

# --- API ---
PORT=3000
# Mismo origen que DOMINIO (la web y la API se sirven juntas).
CORS_ORIGIN=https://agroprecios.example.org
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- PostgreSQL (contenedor db; no se expone a internet) ---
DB_USER=agroprecios
# Generar una clave larga y aleatoria.
DB_PASSWORD=cambiar_por_clave_larga_aleatoria
DB_NAME=agroprecios
DB_NAME_TEST=agroprecios_test

# --- Administrador inicial (lo crea seed:prod si no existe) ---
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=cambiar_minimo_12_caracteres

# --- JWT (mínimo 32 caracteres) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio_de_produccion
JWT_EXPIRES_IN=15m

# --- Ingesta (horarios en zona America/Bogota; ver docs/DOCUMENTACION.md) ---
INGESTA_PROGRAMADA=true
TRM_CRON=0 30 7,18 * * *
SIPSA_CRON=0 30 15 * * 1-6
SIPSA_DIAS_VENTANA=45
WORLDBANK_CRON=0 0 9 * * 1
WORLDBANK_URL=https://thedocs.worldbank.org/en/doc/74e8be41ceb20fa0da750cda2f6b9e4e-0050012026/related/CMO-Historical-Data-Monthly.xlsx
FAOSTAT_CRON=0 0 10 1 * *
FAOSTAT_URL=https://bulks-faostat.fao.org/production/Prices_E_All_Data_(Normalized).zip

# --- Respaldos ---
RESPALDO_DIAS_RETENCION=14
