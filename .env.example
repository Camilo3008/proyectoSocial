# Copiar a .env (raíz del repo) y ajustar. Nunca subir .env al repositorio.
# Los valores de abajo son SOLO de ejemplo para desarrollo local.

# --- General ---
NODE_ENV=development
PORT=3000
# Origen permitido por CORS (frontend). Varios separados por coma.
CORS_ORIGIN=http://localhost:4200

# --- PostgreSQL (lo usan docker-compose y la API) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=agroprecios
DB_PASSWORD=cambiar_esta_clave_local
DB_NAME=agroprecios
# Base de datos para pruebas e2e (se crea automáticamente en el contenedor)
DB_NAME_TEST=agroprecios_test

# --- Rate limiting (ventana en ms y número de peticiones por IP) ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Administrador inicial (lo crea `npm run seed` si no existe) ---
ADMIN_EMAIL=admin@example.com
# Mínimo 12 caracteres
ADMIN_PASSWORD=cambiar_esta_clave_admin

# --- JWT del administrador (obligatorio; mínimo 32 caracteres) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Duración del token: número + unidad (s, m, h, d)
JWT_EXPIRES_IN=15m

# --- Ingesta ---
# Activa los jobs programados (TRM diaria). Poner en false para trabajar sin red.
INGESTA_PROGRAMADA=true
# Horarios (cron con segundos, zona America/Bogota). Ajustables sin cambiar código.
TRM_CRON=0 30 7,18 * * *
# El DANE actualiza SIPSA a las 2:00 p. m.; cada consulta descarga ~316 MB.
SIPSA_CRON=0 30 15 * * 1-6
# Días hacia atrás que se guardan en cada ingesta SIPSA (el histórico completo se carga a mano con ?desde=).
SIPSA_DIAS_VENTANA=45
