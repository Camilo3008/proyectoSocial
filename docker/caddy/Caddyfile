# Caddy: sirve la PWA y hace de proxy inverso hacia la API.
# Con un dominio real en DOMINIO, Caddy obtiene y renueva solo el certificado
# HTTPS (Let's Encrypt); los puertos 80 y 443 deben estar abiertos.
# Con DOMINIO=localhost usa un certificado local (para pruebas).
{
	email {$ACME_EMAIL}
}

{$DOMINIO:localhost} {
	encode zstd gzip

	# --- API ---
	# La API pone sus propios encabezados (helmet, Cache-Control, ETag).
	handle /api/* {
		reverse_proxy api:3000
	}

	# --- PWA ---
	handle {
		root * /srv

		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			# style-src 'unsafe-inline': Angular inserta los estilos de los componentes en <style>.
			# worker-src/child-src blob: y img-src blob: los necesita MapLibre (globo).
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}

		# El service worker y el índice nunca se guardan en la caché HTTP: así
		# las actualizaciones llegan (el SW maneja su propia caché offline).
		@sin_cache path / /index.html /ngsw.json /ngsw-worker.js /safety-worker.js /worker-basic.min.js /manifest.webmanifest
		header @sin_cache Cache-Control "no-cache"

		# Archivos con hash en el nombre (main-ABC123.js): inmutables.
		@con_hash path_regexp -[A-Za-z0-9_-]{8}\.(js|css)$
		header @con_hash Cache-Control "public, max-age=31536000, immutable"

		@geo path /geo/*
		header @geo Cache-Control "public, max-age=604800"

		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
